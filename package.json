{
  "name": "ride-sharing-app",
  "version": "1.0.0",
  "description": "A ride sharing application",
  "type": "module",
  "main": "src/app.js",
  "prisma": {
  "seed": "node prisma/seed.js"
},
  "scripts": {
    "start": "node src/app.js",
    "dev": "concurrently \"npm run tailwind:watch\" \"nodemon src/app.js\"",
    "tailwind:watch": "tailwindcss -i ./src/css/input.css -o ./public/css/output.css --watch"
  },
  "keywords": [
    "ride",
    "sharing"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^17.2.3",
    "ejs": "^3.1.8",
    "express": "^4.18.2",
    "@prisma/client": "^5.0.0",
    "prisma": "^5.0.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.0",
    "nodemon": "^3.0.1",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.3.5"
  }
}
