{
  "name": "ride-sharing-app",
  "version": "1.0.0",
  "description": "A ride sharing application",
  "type": "module",
  "main": "src/app.js",
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "scripts": {
    "start": "node src/app.js",
    "dev": "concurrently \"npm run tailwind:watch\" \"nodemon src/app.js\"",
    "tailwind:watch": "tailwindcss -i ./src/css/input.css -o ./public/css/output.css --watch",
    "build": "tailwindcss -i ./src/css/input.css -o ./public/css/output.css",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx"
  },
  "keywords": [
    "ride",
    "sharing"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.0.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "ejs": "^3.1.8",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.0",
    "morgan": "^1.10.0",
    "prisma": "^5.0.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.0",
    "nodemon": "^3.0.1",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.3.5"
  }
}
