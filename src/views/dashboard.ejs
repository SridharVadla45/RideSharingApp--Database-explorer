<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Database Explorer | Prisma Studio</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');
        
        body {
            font-family: 'Inter', sans-serif;
            background-color: #0f172a;
            color: #e2e8f0;
        }
        
        .sidebar-bg {
            background: linear-gradient(180deg, #1e293b 0%, #0f172a 100%);
        }
        
        .content-bg {
            background-color: #0f172a;
        }
        
        .card-bg {
            background-color: #1e293b;
            border: 1px solid #334155;
        }
        
        .btn-primary {
            background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%);
            transition: all 0.3s ease;
        }
        
        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(59, 130, 246, 0.3);
        }
        
        .sidebar-item.active {
            background: rgba(59, 130, 246, 0.15);
            border-right: 3px solid #3b82f6;
            color: #3b82f6;
        }
        
        .sidebar-item:hover {
            background: rgba(59, 130, 246, 0.08);
        }
        
        .table-row:hover {
            background: #1e293b;
        }
        
        .chart-container {
            position: relative;
            height: 300px;
            width: 100%;
        }
        
        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.7);
            z-index: 1000;
            align-items: center;
            justify-content: center;
        }
        
        .modal-content {
            background: #1e293b;
            border-radius: 12px;
            width: 90%;
            max-width: 600px;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
            max-height: 90vh;
            overflow-y: auto;
            border: 1px solid #334155;
        }
        
        .fade-in {
            animation: fadeIn 0.3s ease-out;
        }
        
        .tab-button.active {
            background: rgba(59, 130, 246, 0.15);
            color: #3b82f6;
            border-bottom: 2px solid #3b82f6;
        }
        
        .loading {
            display: inline-block;
            width: 20px;
            height: 20px;
            border: 3px solid rgba(255,255,255,.3);
            border-radius: 50%;
            border-top-color: #fff;
            animation: spin 1s ease-in-out infinite;
        }
        
        @keyframes spin {
            to { transform: rotate(360deg); }
        }
        
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(-10px); }
            to { opacity: 1; transform: translateY(0); }
        }
        
        .schema-table {
            transition: all 0.3s ease;
        }
        
        .schema-table:hover {
            transform: translateX(5px);
            background: rgba(59, 130, 246, 0.08);
        }
        
        .table-header {
            background: #1e293b;
            border-bottom: 1px solid #334155;
        }
        
        .table-cell {
            border-color: #334155;
        }
        
        input, select, textarea {
            background-color: #1e293b;
            border-color: #475569;
            color: #e2e8f0;
        }
        
        input:focus, select:focus, textarea:focus {
            border-color: #3b82f6;
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
        }
        
        .analytics-card {
            transition: all 0.3s ease;
            background: linear-gradient(145deg, #1e293b, #1a2438);
            border: 1px solid #334155;
        }
        
        .analytics-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3);
            border-color: #475569;
        }
        
        .stat-highlight {
            background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        
        .gradient-text {
            background: linear-gradient(135deg, #3b82f6 0%, #8b5cf6 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        
        .form-input {
            background-color: #1e293b;
            border: 1px solid #475569;
            border-radius: 8px;
            padding: 12px;
            color: #e2e8f0;
            width: 100%;
            transition: all 0.3s ease;
        }
        
        .form-input:focus {
            border-color: #3b82f6;
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
            outline: none;
        }
        
        .form-label {
            display: block;
            margin-bottom: 8px;
            font-weight: 500;
            color: #e2e8f0;
        }
        
        .form-group {
            margin-bottom: 20px;
        }
    </style>
</head>
<body class="content-bg">
    <!-- Fixed Navbar -->
    <nav class="fixed top-0 left-0 right-0 card-bg shadow-lg z-50 border-b border-slate-700">
        <div class="flex items-center justify-between px-6 py-3">
            <!-- Logo and Brand -->
            <div class="flex items-center space-x-3">
                <div class="w-10 h-10 bg-blue-600 rounded-xl flex items-center justify-center">
                    <i class="fas fa-database text-white text-lg"></i>
                </div>
                <div>
                    <h1 class="text-xl font-bold text-white">Database Explorer</h1>
                    <p class="text-xs text-slate-400">Powered by Prisma</p>
                </div>
            </div>
            
            <!-- Connection Status -->
            <div class="flex items-center space-x-4">
                <div class="flex items-center space-x-2 px-3 py-1 rounded-full bg-green-900/30 text-green-400 border border-green-800/50">
                    <i class="fas fa-circle text-xs"></i>
                    <span class="text-sm font-medium">Connected</span>
                </div>
                
                <div class="relative group">
                    <button class="flex items-center space-x-2 bg-slate-700 hover:bg-slate-600 rounded-lg px-3 py-2 transition-colors">
                        <div class="w-8 h-8 bg-blue-600 rounded-full flex items-center justify-center">
                            <span class="text-white font-semibold text-sm">AD</span>
                        </div>
                        <span class="text-slate-200 font-medium">Admin</span>
                        <i class="fas fa-chevron-down text-slate-400 text-xs"></i>
                    </button>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <div class="pt-16 flex">
        <!-- Sidebar -->
        <div class="w-64 sidebar-bg h-screen fixed pt-4 border-r border-slate-700">
            <div class="px-4 py-2">
                <h2 class="text-xs uppercase text-slate-400 font-semibold tracking-wider mb-2">Navigation</h2>
                <ul class="space-y-1">
                    <li>
                        <a href="#" class="sidebar-item active flex items-center space-x-3 py-2 px-3 rounded-lg text-slate-200" data-tab="tables">
                            <i class="fas fa-table w-5"></i>
                            <span>Data Browser</span>
                        </a>
                    </li>
                    <li>
                        <a href="#" class="sidebar-item flex items-center space-x-3 py-2 px-3 rounded-lg text-slate-200" data-tab="add-data">
                            <i class="fas fa-plus w-5"></i>
                            <span>Add Records</span>
                        </a>
                    </li>
                    <li>
                        <a href="#" class="sidebar-item flex items-center space-x-3 py-2 px-3 rounded-lg text-slate-200" data-tab="analytics">
                            <i class="fas fa-chart-bar w-5"></i>
                            <span>Analytics</span>
                        </a>
                    </li>
                </ul>
                
                <h2 class="text-xs uppercase text-slate-400 font-semibold tracking-wider mt-6 mb-2">Database Schema</h2>
                <div id="schemaList" class="max-h-64 overflow-y-auto">
                    <!-- Schema will be populated dynamically -->
                </div>
            </div>
        </div>

        <!-- Page Content -->
        <div class="ml-64 flex-1 p-6">
            <!-- Data Browser Section -->
            <div id="tablesSection" class="content-section">
                <div class="mb-6">
                    <h1 class="text-2xl font-bold text-white mb-2">Data Browser</h1>
                    <p class="text-slate-400">Explore and manage your database records</p>
                </div>
                
                <div class="card-bg rounded-xl shadow-lg p-6 mb-6">
                    <div class="flex space-x-4 mb-6">
                        <div class="flex-1">
                            <label class="block text-sm font-medium text-slate-300 mb-2">Select Table</label>
                            <select id="tableSelector" class="w-full px-4 py-2 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none transition">
                                <option value="">-- Select a table --</option>
                            </select>
                        </div>
                        <div class="flex items-end">
                            <button id="loadTableDataBtn" class="btn-primary text-white font-medium px-4 py-2 rounded-lg">
                                <i class="fas fa-sync-alt mr-2"></i>Load Data
                            </button>
                        </div>
                    </div>
                    
                    <div id="tableDataContainer" class="border border-slate-700 rounded-lg overflow-hidden">
                        <div class="bg-slate-800 p-8 text-center text-slate-400">
                            <i class="fas fa-table text-3xl mb-2 block"></i>
                            Select a table and click "Load Data" to view its contents
                        </div>
                    </div>
                </div>
            </div>

            <!-- Add Records Section -->
            <div id="addDataSection" class="content-section hidden">
                <div class="mb-6">
                    <h1 class="text-2xl font-bold text-white mb-2">Add Records</h1>
                    <p class="text-slate-400">Create new records in your database</p>
                </div>
                
                <div class="card-bg rounded-xl shadow-lg p-6 mb-6">
                    <div class="mb-6">
                        <h3 class="text-lg font-semibold text-slate-200 mb-3">Select Table</h3>
                        <div class="flex space-x-4">
                            <div class="flex-1">
                                <select id="addDataTableSelector" class="w-full px-4 py-2 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none transition">
                                    <option value="">-- Select a table --</option>
                                </select>
                            </div>
                            <div>
                                <button id="generateFormBtn" class="btn-primary text-white font-medium px-4 py-2 rounded-lg">
                                    <i class="fas fa-plus mr-2"></i>Generate Form
                                </button>
                            </div>
                        </div>
                    </div>
                    
                    <div id="dataFormContainer">
                        <div class="bg-slate-800 p-8 text-center text-slate-400 rounded-lg">
                            <i class="fas fa-edit text-3xl mb-2 block"></i>
                            Select a table and click "Generate Form" to create a data entry form
                        </div>
                    </div>
                    
                    <div class="mt-6 flex justify-end hidden" id="submitDataContainer">
                        <button id="submitDataBtn" class="btn-primary text-white font-medium px-4 py-2 rounded-lg">
                            <i class="fas fa-save mr-2"></i>Add Record
                        </button>
                    </div>
                </div>
            </div>

            <!-- Analytics Section -->
            <div id="analyticsSection" class="content-section hidden">
                <div class="mb-6">
                    <h1 class="text-2xl font-bold text-white mb-2">Analytics Dashboard</h1>
                    <p class="text-slate-400">Gain insights from your data with visual analytics</p>
                </div>
                
                <!-- Quick Stats -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
                    <div class="analytics-card rounded-xl p-5">
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="text-sm text-slate-400">Total Records</p>
                                <h3 id="totalRecords" class="text-2xl font-bold stat-highlight mt-1">-</h3>
                                <p class="text-xs text-green-500 mt-1">
                                    <i class="fas fa-arrow-up mr-1"></i>Loading...
                                </p>
                            </div>
                            <div class="w-12 h-12 bg-blue-500/20 rounded-lg flex items-center justify-center">
                                <i class="fas fa-database text-blue-400 text-lg"></i>
                            </div>
                        </div>
                    </div>
                    
                    <div class="analytics-card rounded-xl p-5">
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="text-sm text-slate-400">Database Size</p>
                                <h3 id="dbSize" class="text-2xl font-bold stat-highlight mt-1">-</h3>
                                <p class="text-xs text-green-500 mt-1">
                                    <i class="fas fa-arrow-up mr-1"></i>Loading...
                                </p>
                            </div>
                            <div class="w-12 h-12 bg-purple-500/20 rounded-lg flex items-center justify-center">
                                <i class="fas fa-hdd text-purple-400 text-lg"></i>
                            </div>
                        </div>
                    </div>
                    
                    <div class="analytics-card rounded-xl p-5">
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="text-sm text-slate-400">Query Performance</p>
                                <h3 id="queryPerformance" class="text-2xl font-bold stat-highlight mt-1">-</h3>
                                <p class="text-xs text-green-500 mt-1">
                                    <i class="fas fa-bolt mr-1"></i>Loading...
                                </p>
                            </div>
                            <div class="w-12 h-12 bg-green-500/20 rounded-lg flex items-center justify-center">
                                <i class="fas fa-tachometer-alt text-green-400 text-lg"></i>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Analytics Tools -->
                <div class="card-bg rounded-xl shadow-lg p-6 mb-6">
                    <h2 class="text-xl font-bold text-white mb-6">Analytics Tools</h2>
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
                        <div class="analytics-card rounded-xl p-5 cursor-pointer" data-type="forecast">
                            <div class="flex flex-col items-center text-center">
                                <div class="w-16 h-16 bg-blue-500/20 rounded-xl flex items-center justify-center mb-4">
                                    <i class="fas fa-chart-line text-blue-400 text-2xl"></i>
                                </div>
                                <h3 class="font-semibold text-slate-200 mb-2">Budget Forecast</h3>
                                <p class="text-sm text-slate-400">Project future expenses with inflation</p>
                            </div>
                        </div>
                        
                        <div class="analytics-card rounded-xl p-5 cursor-pointer" data-type="topN">
                            <div class="flex flex-col items-center text-center">
                                <div class="w-16 h-16 bg-green-500/20 rounded-xl flex items-center justify-center mb-4">
                                    <i class="fas fa-trophy text-green-400 text-2xl"></i>
                                </div>
                                <h3 class="font-semibold text-slate-200 mb-2">Top/Bottom N</h3>
                                <p class="text-sm text-slate-400">Find best or worst performing items</p>
                            </div>
                        </div>
                        
                        <div class="analytics-card rounded-xl p-5 cursor-pointer" data-type="custom">
                            <div class="flex flex-col items-center text-center">
                                <div class="w-16 h-16 bg-purple-500/20 rounded-xl flex items-center justify-center mb-4">
                                    <i class="fas fa-code text-purple-400 text-2xl"></i>
                                </div>
                                <h3 class="font-semibold text-slate-200 mb-2">Custom Query</h3>
                                <p class="text-sm text-slate-400">Run your own SQL analysis</p>
                            </div>
                        </div>
                    </div>
                    
                    <div id="analyticsFormsContainer">
                        <div class="bg-slate-800 p-8 text-center text-slate-400 rounded-lg">
                            <i class="fas fa-chart-bar text-3xl mb-2 block"></i>
                            Select an analytics tool to get started
                        </div>
                    </div>
                    
                    <div id="analyticsResultsContainer" class="mt-6 hidden">
                        <h3 class="text-lg font-semibold text-slate-200 mb-3">Analysis Results</h3>
                        <div class="card-bg rounded-lg p-4">
                            <div id="analyticsResultsContent">
                                <!-- Results will be displayed here -->
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Charts Section -->
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                    <div class="card-bg rounded-xl shadow-lg p-6">
                        <h3 class="text-lg font-semibold text-slate-200 mb-4">Record Distribution</h3>
                        <div class="chart-container">
                            <canvas id="distributionChart"></canvas>
                        </div>
                    </div>
                    
                    <div class="card-bg rounded-xl shadow-lg p-6">
                        <h3 class="text-lg font-semibold text-slate-200 mb-4">Monthly Activity</h3>
                        <div class="chart-container">
                            <canvas id="activityChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Message Modal -->
    <div id="messageModal" class="modal">
        <div class="modal-content fade-in">
            <div class="p-6 border-b border-slate-700">
                <h2 class="text-xl font-bold text-white" id="modalTitle">Success</h2>
            </div>
            <div class="p-6">
                <div id="modalMessage" class="mb-4">
                    <!-- Message will appear here -->
                </div>
                <div class="flex justify-end">
                    <button id="closeModalBtn" class="btn-primary text-white font-medium px-4 py-2 rounded-lg">
                        OK
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script>
        // Application state
        const appState = {
            schema: [], // Will be populated from API
            tableData: {},
            selectedTable: null
        };

        // API Configuration
        const API_BASE_URL = `http://localhost:4000/api`;
        
        // DOM Elements
        const tablesSection = document.getElementById('tablesSection');
        const addDataSection = document.getElementById('addDataSection');
        const analyticsSection = document.getElementById('analyticsSection');
        const schemaList = document.getElementById('schemaList');
        const tableSelector = document.getElementById('tableSelector');
        const loadTableDataBtn = document.getElementById('loadTableDataBtn');
        const tableDataContainer = document.getElementById('tableDataContainer');
        const addDataTableSelector = document.getElementById('addDataTableSelector');
        const generateFormBtn = document.getElementById('generateFormBtn');
        const dataFormContainer = document.getElementById('dataFormContainer');
        const submitDataContainer = document.getElementById('submitDataContainer');
        const submitDataBtn = document.getElementById('submitDataBtn');
        const analyticsFormsContainer = document.getElementById('analyticsFormsContainer');
        const analyticsResultsContainer = document.getElementById('analyticsResultsContainer');
        const analyticsResultsContent = document.getElementById('analyticsResultsContent');
        const messageModal = document.getElementById('messageModal');
        const modalTitle = document.getElementById('modalTitle');
        const modalMessage = document.getElementById('modalMessage');
        const closeModalBtn = document.getElementById('closeModalBtn');
        const totalRecordsEl = document.getElementById('totalRecords');
        const dbSizeEl = document.getElementById('dbSize');
        const queryPerformanceEl = document.getElementById('queryPerformance');

        // Initialize the application
        document.addEventListener('DOMContentLoaded', function() {
            setupEventListeners();
            initializeApp();
        });

        // Set up all event listeners
        function setupEventListeners() {
            // Navigation
            document.querySelectorAll('.sidebar-item').forEach(item => {
                item.addEventListener('click', function(e) {
                    e.preventDefault();
                    const tab = this.getAttribute('data-tab');
                    switchTab(tab);
                });
            });
            
            // Table operations
            loadTableDataBtn.addEventListener('click', loadTableData);
            
            // Add data operations
            generateFormBtn.addEventListener('click', generateDataForm);
            submitDataBtn.addEventListener('click', submitData);
            
            // Analytics
            document.querySelectorAll('.analytics-card[data-type]').forEach(card => {
                card.addEventListener('click', function() {
                    const type = this.getAttribute('data-type');
                    showAnalyticsForm(type);
                });
            });
            
            // Modal
            closeModalBtn.addEventListener('click', () => {
                messageModal.style.display = 'none';
            });
        }

        // Initialize the application with real data
        async function initializeApp() {
            try {
                await loadSchema();
                await initializeCharts();
                await loadAnalyticsStats();
            } catch (error) {
                console.error('Error initializing app:', error);
                showMessage('Failed to initialize application. Please check your API connection.', 'error');
            }
        }

        // Load schema from API
        async function loadSchema() {
            try {
                const response = await fetch(`${API_BASE_URL}/schema`);
                if (!response.ok) throw new Error('Failed to fetch schema');
                
                const data = await response.json();
                appState.schema = data.tables;

                console.log('Loaded schema:', appState.schema);
                
                populateTableSelectors();
                populateSchemaList();
                
            } catch (error) {
                console.error('Error loading schema:', error);
                appState.schema = getSampleSchema();
                populateTableSelectors();
                populateSchemaList();
                showMessage('Using sample data. API connection failed.', 'error');
            }
        }

        // Get sample schema for fallback
        function getSampleSchema() {
            return [
                { 
                    name: 'user', 
                    columns: ['user_id', 'name', 'email', 'phone_number']
                },
                { 
                    name: 'driver', 
                    columns: ['driver_id', 'name', 'email', 'phone_number']
                },
                { 
                    name: 'vehicle', 
                    columns: ['vehicle_id', 'type', 'model', 'license_plate_no']
                }
            ];
        }

        // Initialize charts
        async function initializeCharts() {
            try {
                // Distribution Chart
                const distributionCtx = document.getElementById('distributionChart').getContext('2d');
                new Chart(distributionCtx, {
                    type: 'doughnut',
                    data: {
                        labels: ['Users', 'Drivers', 'Vehicles', 'Rides', 'Payments'],
                        datasets: [{
                            data: [35, 20, 25, 40, 35],
                            backgroundColor: [
                                'rgba(59, 130, 246, 0.8)',
                                'rgba(16, 185, 129, 0.8)',
                                'rgba(245, 158, 11, 0.8)',
                                'rgba(139, 92, 246, 0.8)',
                                'rgba(239, 68, 68, 0.8)'
                            ],
                            borderColor: [
                                'rgb(59, 130, 246)',
                                'rgb(16, 185, 129)',
                                'rgb(245, 158, 11)',
                                'rgb(139, 92, 246)',
                                'rgb(239, 68, 68)'
                            ],
                            borderWidth: 1
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                position: 'bottom',
                                labels: {
                                    color: '#e2e8f0'
                                }
                            }
                        }
                    }
                });
                
                // Activity Chart
                const activityCtx = document.getElementById('activityChart').getContext('2d');
                new Chart(activityCtx, {
                    type: 'line',
                    data: {
                        labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun'],
                        datasets: [{
                            label: 'Rides',
                            data: [65, 78, 66, 84, 105, 120],
                            borderColor: 'rgb(59, 130, 246)',
                            backgroundColor: 'rgba(59, 130, 246, 0.1)',
                            borderWidth: 2,
                            tension: 0.4,
                            fill: true
                        }, {
                            label: 'Payments',
                            data: [45, 62, 55, 70, 92, 105],
                            borderColor: 'rgb(16, 185, 129)',
                            backgroundColor: 'rgba(16, 185, 129, 0.1)',
                            borderWidth: 2,
                            tension: 0.4,
                            fill: true
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                position: 'bottom',
                                labels: {
                                    color: '#e2e8f0'
                                }
                            }
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                grid: {
                                    color: 'rgba(255, 255, 255, 0.1)'
                                },
                                ticks: {
                                    color: '#94a3b8'
                                }
                            },
                            x: {
                                grid: {
