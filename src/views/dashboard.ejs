        // Populate schema list in sidebar
        function populateSchemaList() {
            schemaList.innerHTML = '';
            
            appState.schema.forEach(table => {
                const tableElement = document.createElement('div');
                tableElement.className = 'schema-table flex items-center space-x-3 py-2 px-3 rounded-lg text-slate-200 cursor-pointer';
                tableElement.innerHTML = `
                    <i class="fas fa-table w-5 text-slate-400"></i>
                    <div>
                        <div class="font-medium">${table.name}</div>
                        <div class="text-xs text-slate-500">${table.columns.length} columns</div>
