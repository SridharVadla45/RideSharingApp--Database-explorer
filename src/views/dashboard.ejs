                    </div>

                    <div class="mt-8 flex justify-end">
                        <button id="submitDriverVehicleBtn" class="btn-primary text-white font-medium px-8 py-3 rounded-lg shadow-lg hover:shadow-xl transition-all flex items-center text-lg">
                            <i class="fas fa-save mr-2"></i>Register All
                        </button>
                    </div>
                    `;

        dataFormContainer.appendChild(formSection);

        document.getElementById('submitDriverVehicleBtn').addEventListener('click', submitRegisterDriver);
    }

    // Submit Register Driver
    async function submitRegisterDriver() {
        const driverName = document.getElementById('driverName').value;
        const driverEmail = document.getElementById('driverEmail').value;
        const driverPhone = document.getElementById('driverPhone').value;
        const vehicleType = document.getElementById('vehicleType').value;
        const vehicleModel = document.getElementById('vehicleModel').value;
        const vehicleLicense = document.getElementById('vehicleLicense').value;

        if (!driverName || !driverEmail || !vehicleType || !vehicleModel || !vehicleLicense) {
            showMessage('Please fill in all required fields', 'error');
            return;
        }

        const btn = document.getElementById('submitDriverVehicleBtn');
        btn.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i>Processing...';
        btn.disabled = true;

        try {
            const response = await fetchWithAuth(`${API_BASE_URL}/transactions/register-driver-vehicle`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    driver: { name: driverName, email: driverEmail, phone: driverPhone },
                    vehicle: { type: vehicleType, model: vehicleModel, licensePlate: vehicleLicense }
                })
            });

            const result = await response.json();

            if (!response.ok) {
                throw new Error(result.error || 'Transaction failed');
            }

            showMessage('Driver and Vehicle registered successfully!', 'success');

            // Clear form
            document.getElementById('driverName').value = '';
            document.getElementById('driverEmail').value = '';
            document.getElementById('driverPhone').value = '';
            document.getElementById('vehicleType').value = '';
            document.getElementById('vehicleModel').value = '';
            document.getElementById('vehicleLicense').value = '';

        } catch (error) {
            console.error('Error registering:', error);
            showMessage(error.message, 'error');
        } finally {
            btn.innerHTML = '<i class="fas fa-save mr-2"></i>Register All';
            btn.disabled = false;
        }
    }

    // Show analytics form based on selected type
    function showAnalyticsForm(type) {
        analyticsFormsContainer.innerHTML = '';
        analyticsResultsContainer.classList.add('hidden');

        if (type === 'forecast') {
            analyticsFormsContainer.innerHTML = `
                    <h3 class="text-lg font-bold text-gray-900 mb-3">Budget Forecast Configuration</h3>
                    <p class="text-sm text-gray-500 mb-6">Forecast total revenue for the next 3 years based on historical data.</p>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">Inflation Rate (%)</label>
                            <input type="number" id="inflationRate" class="form-input" value="3" min="0" max="50" step="0.1">
                        </div>
                    </div>
                    <button id="runForecastBtn" class="btn-primary text-white font-medium px-6 py-2.5 rounded-lg shadow-md flex items-center">
                        <i class="fas fa-calculator mr-2"></i>Run Forecast
                    </button>
                `;

            document.getElementById('runForecastBtn').addEventListener('click', runBudgetForecast);

        } else if (type === 'drivers') {
            analyticsFormsContainer.innerHTML = `
                    <h3 class="text-lg font-bold text-gray-900 mb-3">Top Drivers Analysis</h3>
                    <p class="text-sm text-gray-500 mb-6">Identify the highest rated drivers.</p>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">Number of Results (N)</label>
                            <input type="number" id="resultCount" class="form-input" value="5" min="1" max="50">
                        </div>
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">Analysis Type</label>
                            <select id="analysisType" class="form-input">
                                <option value="best">Best Rated</option>
                                <option value="worst">Worst Rated</option>
                            </select>
                        </div>
                    </div>
                    <button id="runTopDriversBtn" class="btn-primary text-white font-medium px-6 py-2.5 rounded-lg shadow-md flex items-center">
                        <i class="fas fa-chart-bar mr-2"></i>Run Analysis
                    </button>
                `;

            document.getElementById('runTopDriversBtn').addEventListener('click', runTopDriversAnalysis);

        } else if (type === 'custom') {
            analyticsFormsContainer.innerHTML = `
                    <h3 class="text-lg font-bold text-gray-900 mb-3">Custom SQL Query</h3>
                    <div class="mb-6">
                        <label class="block text-sm font-semibold text-gray-700 mb-2">Enter SQL Query</label>
                        <textarea id="customQuery" class="form-input font-mono text-sm" rows="5" placeholder="SELECT * FROM table_name"></textarea>
                    </div>
                    <button id="runCustomQueryBtn" class="btn-primary text-white font-medium px-6 py-2.5 rounded-lg shadow-md flex items-center">
                        <i class="fas fa-play mr-2"></i>Run Query
                    </button>
                `;

            document.getElementById('runCustomQueryBtn').addEventListener('click', runCustomQuery);
        }
    }

    // Run budget forecast analysis
    async function runBudgetForecast() {
        const inflationRate = document.getElementById('inflationRate').value / 100;
        const btn = document.getElementById('runForecastBtn');

        btn.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i>Calculating...';
        btn.disabled = true;

        try {
            const response = await fetchWithAuth(`${API_BASE_URL}/analytics/forecast?inflationRate=${inflationRate}`);
            const data = await response.json();

            if (!response.ok) throw new Error(data.error || 'Failed to get forecast');

            displayAnalyticsResults('Budget Forecast', `
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
                        <div class="bg-indigo-50 p-4 rounded-xl border border-indigo-100">
                            <div class="text-xs font-bold text-indigo-500 uppercase tracking-wide">Base Annual Revenue</div>
                            <div class="text-2xl font-bold text-indigo-900 mt-1">$${data.baseAmount}</div>
                        </div>
                        <div class="bg-emerald-50 p-4 rounded-xl border border-emerald-100">
                            <div class="text-xs font-bold text-emerald-500 uppercase tracking-wide">Inflation Rate</div>
                            <div class="text-2xl font-bold text-emerald-900 mt-1">${data.inflationRate}</div>
                        </div>
                    </div>

                    <div class="overflow-hidden rounded-xl border border-gray-200">
                        <table class="w-full text-left">
                            <thead class="bg-gray-50 text-gray-500 font-semibold text-xs uppercase">
                                <tr>
                                    <th class="p-4">Year</th>
                                    <th class="p-4">Projected Revenue</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-200 bg-white">
                                ${data.forecast.map(f => `
                                    <tr>
                                        <td class="p-4 text-gray-900 font-medium">${f.year}</td>
                                        <td class="p-4 text-emerald-600 font-mono font-bold">$${f.amount}</td>
                                    </tr>
                                `).join('')}
                            </tbody>
                        </table>
                    </div>
                    <p class="mt-4 text-xs text-gray-400 italic">${data.note}</p>
                    `);

        } catch (error) {
            showMessage(error.message, 'error');
        } finally {
            btn.innerHTML = '<i class="fas fa-calculator mr-2"></i>Run Forecast';
            btn.disabled = false;
        }
    }

    // Run Top Drivers analysis
    async function runTopDriversAnalysis() {
        const n = document.getElementById('resultCount').value;
        const type = document.getElementById('analysisType').value;
        const btn = document.getElementById('runTopDriversBtn');

        btn.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i>Analyzing...';
        btn.disabled = true;

        try {
            const response = await fetchWithAuth(`${API_BASE_URL}/analytics/top-drivers?n=${n}&type=${type}`);
            const data = await response.json();

            if (!response.ok) throw new Error(data.error || 'Failed to get analysis');

            displayAnalyticsResults(`${type === 'best' ? 'Top' : 'Bottom'} ${n} Drivers`, `
                    <div class="overflow-hidden rounded-xl border border-gray-200">
                        <table class="w-full text-left">
                            <thead class="bg-gray-50 text-gray-500 font-semibold text-xs uppercase">
                                <tr>
                                    <th class="p-4">Driver</th>
                                    <th class="p-4">Email</th>
                                    <th class="p-4">Avg Score</th>
                                    <th class="p-4">Reviews</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-200 bg-white">
                                ${data.map(d => `
                                    <tr class="hover:bg-gray-50 transition-colors">
                                        <td class="p-4 text-gray-900 font-bold">${d.name}</td>
                                        <td class="p-4 text-gray-500 text-sm">${d.email}</td>
                                        <td class="p-4">
                                            <div class="flex items-center">
                                                <span class="text-amber-500 font-bold mr-1.5">${d.avgScore}</span>
                                                <div class="flex text-amber-400 text-xs">
                                                    ${Array(Math.round(d.avgScore)).fill('<i class="fas fa-star"></i>').join('')}
                                                </div>
                                            </div>
                                        </td>
                                        <td class="p-4 text-gray-600 font-medium">${d.reviewCount}</td>
                                    </tr>
                                `).join('')}
                            </tbody>
                        </table>
                    </div>
                    `);

        } catch (error) {
            showMessage(error.message, 'error');
        } finally {
            btn.innerHTML = '<i class="fas fa-chart-bar mr-2"></i>Run Analysis';
            btn.disabled = false;
        }
    }

    function displayAnalyticsResults(title, content) {
        analyticsResultsContainer.classList.remove('hidden');
        analyticsResultsContainer.querySelector('h3').textContent = title;
        analyticsResultsContent.innerHTML = content;
    }

    // Run custom query
    async function runCustomQuery() {
        const query = document.getElementById('customQuery').value.trim();
        const btn = document.getElementById('runCustomQueryBtn');

        if (!query) {
            showMessage('Please enter a SQL query', 'error');
            return;
        }

        btn.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i>Executing...';
        btn.disabled = true;

        try {
            const response = await fetchWithAuth(`${API_BASE_URL}/analytics/custom-query`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ query })
            });

            const data = await response.json();

            if (!response.ok) {
                throw new Error(data.error || data.details || 'Failed to execute query');
            }

            // Display results
            if (data.rowCount === 0) {
                displayAnalyticsResults('Query Results', `
                    <div class="text-center py-8">
                        <i class="fas fa-info-circle text-4xl text-blue-500 mb-3"></i>
                        <p class="text-gray-600">${data.message || 'No results found'}</p>
                    </div>
                `);
            } else {
                const tableHtml = `
                    <div class="mb-4">
                        <p class="text-sm text-gray-600">
                            <i class="fas fa-check-circle text-green-500 mr-2"></i>
                            ${data.message} - <span class="font-medium">${data.rowCount} rows</span> returned
                        </p>
                    </div>
                    <div class="overflow-x-auto rounded-xl border border-gray-200">
                        <table class="w-full text-left">
                            <thead class="bg-gray-50 text-gray-500 font-semibold text-xs uppercase">
                                <tr>
                                    ${data.columns.map(col => `<th class="p-4">${col}</th>`).join('')}
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-200 bg-white">
                                ${data.rows.map(row => `
                                    <tr class="hover:bg-gray-50 transition-colors">
                                        ${data.columns.map(col => {
                    const value = row[col] !== null && row[col] !== undefined
                        ? row[col]
                        : '<span class="text-gray-400 italic">NULL</span>';
                    return `<td class="p-4 text-gray-900 text-sm">${value}</td>`;
                }).join('')}
                                    </tr>
                                `).join('')}
                            </tbody>
                        </table>
                    </div>
                    <div class="mt-4 p-3 bg-blue-50 border border-blue-200 rounded-lg">
                        <p class="text-xs text-blue-800">
                            <i class="fas fa-lightbulb mr-1"></i>
                            <strong>Tip:</strong> Try queries like: 
                            <code class="bg-blue-100 px-2 py-1 rounded">SELECT * FROM user LIMIT 10</code> or 
                            <code class="bg-blue-100 px-2 py-1 rounded">SELECT name, email FROM driver WHERE name LIKE '%John%'</code>
                        </p>
                    </div>
                `;

                displayAnalyticsResults('Custom Query Results', tableHtml);
            }

        } catch (error) {
            console.error('Error executing custom query:', error);
            showMessage(error.message, 'error');
        } finally {
            btn.innerHTML = '<i class="fas fa-play mr-2"></i>Run Query';
            btn.disabled = false;
        }
    }

    // Show message in modal
    function showMessage(message, type) {
        if (type === 'success') {
            modalTitle.textContent = 'Success';
            modalTitle.className = 'text-xl font-bold text-emerald-600';
            modalMessage.className = 'mb-4 p-4 rounded-lg bg-emerald-50 text-emerald-800 border border-emerald-100 flex items-start';
            modalMessage.innerHTML = `<i class="fas fa-check-circle mr-3 mt-1 text-emerald-500"></i><span>${message}</span>`;
        } else if (type === 'error') {
            modalTitle.textContent = 'Error';
            modalTitle.className = 'text-xl font-bold text-red-600';
            modalMessage.className = 'mb-4 p-4 rounded-lg bg-red-50 text-red-800 border border-red-100 flex items-start';
            modalMessage.innerHTML = `<i class="fas fa-exclamation-circle mr-3 mt-1 text-red-500"></i><span>${message}</span>`;
        } else {
            modalTitle.textContent = 'Info';
            modalTitle.className = 'text-xl font-bold text-blue-600';
            modalMessage.className = 'mb-4 p-4 rounded-lg bg-blue-50 text-blue-800 border border-blue-100 flex items-start';
            modalMessage.innerHTML = `<i class="fas fa-info-circle mr-3 mt-1 text-blue-500"></i><span>${message}</span>`;
        }

        messageModal.style.display = 'flex';
    }
</script>
</body>

</html>