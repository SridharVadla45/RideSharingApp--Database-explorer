                modalMessage.innerHTML = `<i class="fas fa-check-circle mr-2"></i>${message}`;
            } else if (type === 'error') {
                modalTitle.textContent = 'Error';
                modalMessage.className = 'mb-4 p-4 rounded-lg bg-red-900/30 text-red-400 border border-red-800/50';
                modalMessage.innerHTML = `<i class="fas fa-exclamation-circle mr-2"></i>${message}`;
            } else {
                modalTitle.textContent = 'Info';
                modalMessage.className = 'mb-4 p-4 rounded-lg bg-blue-900/30 text-blue-400 border border-blue-800/50';
                modalMessage.innerHTML = `<i class="fas fa-info-circle mr-2"></i>${message}`;
            }
            
