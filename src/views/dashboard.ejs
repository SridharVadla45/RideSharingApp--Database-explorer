    // Generate page number buttons for pagination
    function generatePageNumbers(currentPage, totalPages) {
        let html = '';
        const maxVisible = 5;
        let startPage = Math.max(1, currentPage - Math.floor(maxVisible / 2));
        let endPage = Math.min(totalPages, startPage + maxVisible - 1);

        if (endPage - startPage < maxVisible - 1) {
            startPage = Math.max(1, endPage - maxVisible + 1);
        }

        for (let i = startPage; i <= endPage; i++) {
            if (i === currentPage) {
                html += `
                    <button onclick="window.changePage(${i})" 
                        class="relative inline-flex items-center px-4 py-2 border border-indigo-500 bg-indigo-50 text-sm font-medium text-indigo-600">
                        ${i}
                    </button>
                `;
            } else {
                html += `
                    <button onclick="window.changePage(${i})"
                        class="relative inline-flex items-center px-4 py-2 border border-gray-300 bg-white text-sm font-medium text-gray-700 hover:bg-gray-50">
                        ${i}
                    </button>
                `;
            }
        }

        return html;
    }

    // Generate page number buttons with data attributes (for event delegation)
    function generatePageNumbersWithData(currentPage, totalPages) {
        let html = '';
        const maxVisible = 5;
        let startPage = Math.max(1, currentPage - Math.floor(maxVisible / 2));
        let endPage = Math.min(totalPages, startPage + maxVisible - 1);

        if (endPage - startPage < maxVisible - 1) {
            startPage = Math.max(1, endPage - maxVisible + 1);
        }

        for (let i = startPage; i <= endPage; i++) {
            if (i === currentPage) {
                html += `
                    <button data-page="${i}" class="pagination-btn relative inline-flex items-center px-4 py-2 border border-indigo-500 bg-indigo-50 text-sm font-medium text-indigo-600">
                        ${i}
                    </button>
                `;
            } else {
                html += `
                    <button data-page="${i}" class="pagination-btn relative inline-flex items-center px-4 py-2 border border-gray-300 bg-white text-sm font-medium text-gray-700 hover:bg-gray-50">
                        ${i}
                    </button>
                `;
            }
        }

        return html;
    }

    // Change page for pagination
    function changePage(newPage) {
        console.log('📄 changePage called with:', newPage);
        const tableName = tableSelector.value;
        if (!tableName || !appState.tableData[tableName]) {
            console.log('❌ No table selected or no data');
            return;
        }

        const totalPages = Math.ceil(appState.pagination.totalRecords / appState.pagination.pageSize);
        if (newPage < 1 || newPage > totalPages) {
            console.log('❌ Invalid page number:', newPage, 'Total pages:', totalPages);
            return;
        }

        console.log('✅ Changing to page:', newPage);
        appState.pagination.currentPage = newPage;
        renderTableData(tableName, appState.tableData[tableName]);
    }

    // Make changePage globally accessible
    window.changePage = changePage;

    // Load table data from API
    async function loadTableData() {
        const tableName = tableSelector.value;

        if (!tableName) {
            showMessage('Please select a table first', 'error');
            return;
        }

        // Reset pagination when loading new table
        appState.pagination.currentPage = 1;

        loadTableDataBtn.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i>Loading...';
        loadTableDataBtn.disabled = true;
        tableDataContainer.innerHTML = `
                <div class="p-12 text-center text-gray-500">
                    <i class="fas fa-spinner fa-spin text-3xl mb-3 text-indigo-600 block"></i>
                    <p>Loading table data...</p>
                </div>
            `;

        try {
            const response = await fetchWithAuth(`${API_BASE_URL}/tables/${tableName}`);

            if (!response.ok) {
                throw new Error(`Failed to fetch data for table: ${tableName}`);
            }

            const tableData = await response.json();
            appState.tableData[tableName] = tableData;

            if (!tableData.rows || tableData.rows.length === 0) {
                tableDataContainer.innerHTML = `
                        <div class="p-12 text-center text-gray-500">
                            <i class="fas fa-inbox text-4xl mb-3 text-gray-300 block"></i>
                            <p>No data found in this table</p>
                        </div>
                    `;
            } else {
                renderTableData(tableName, tableData);
            }

        } catch (error) {
            console.error('Error loading table data:', error);
            tableDataContainer.innerHTML = `
                    <div class="p-12 text-center text-red-500">
                        <i class="fas fa-exclamation-triangle text-3xl mb-3 block"></i>
                        <p>Failed to load data. Please try again.</p>
                    </div>
                `;
            showMessage('Failed to load table data. Please check your API connection.', 'error');
        } finally {
            loadTableDataBtn.innerHTML = '<i class="fas fa-sync-alt mr-2"></i>Load Data';
            loadTableDataBtn.disabled = false;
        }
    }

    // Render table data with pagination
    function renderTableData(tableName, tableData) {
        appState.pagination.totalRecords = tableData.rows.length;
        const { currentPage, pageSize } = appState.pagination;
        const startIndex = (currentPage - 1) * pageSize;
        const endIndex = startIndex + pageSize;
        const paginatedRows = tableData.rows.slice(startIndex, endIndex);
        const totalPages = Math.ceil(tableData.rows.length / pageSize);

        let html = `
            <div class="flex flex-col h-full">
                <!-- Table -->
                <div class="overflow-x-auto bg-white rounded-t-lg shadow flex-grow">
                    <table class="min-w-full divide-y divide-gray-200">
                        <thead class="bg-gray-50">
                            <tr>
            `;

        tableData.columns.forEach(column => {
            html += `<th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">${column}</th>`;
        });

        html += `
                            </tr>
                        </thead>
                        <tbody class="bg-white divide-y divide-gray-200">
            `;

        paginatedRows.forEach((row, index) => {
            const bgClass = index % 2 === 0 ? 'bg-white' : 'bg-gray-50';
            html += `<tr class="${bgClass} hover:bg-indigo-50 transition-colors duration-150">`;
            tableData.columns.forEach(column => {
                const value = row[column] !== null && row[column] !== undefined ? row[column] : '<span class="text-gray-400 italic">NULL</span>';
                html += `<td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">${value}</td>`;
            });
            html += `</tr>`;
        });

        html += `
                        </tbody>
                    </table>
                </div>
                
                <!-- Record Count -->
                <div class="bg-white px-6 py-3 border-t border-gray-200">
                    <p class="text-sm text-gray-700">
                        Showing <span class="font-medium">${startIndex + 1}</span> to <span class="font-medium">${Math.min(endIndex, tableData.rows.length)}</span> of <span class="font-medium">${tableData.rows.length}</span> records
                    </p>
                </div>
                
                <!-- Pagination Controls -->
                <div class="bg-white border-t border-gray-200 px-6 py-4 rounded-b-lg shadow">
                    <div class="flex items-center justify-between">
                        <!-- Mobile Pagination -->
                        <div class="flex-1 flex justify-between sm:hidden">
                            <button data-page="${currentPage - 1}" class="pagination-btn relative inline-flex items-center px-4 py-2 text-sm font-medium rounded-md ${currentPage === 1 ? 'bg-gray-100 text-gray-400 cursor-not-allowed' : 'bg-white text-gray-700 border border-gray-300 hover:bg-gray-50'}" ${currentPage === 1 ? 'disabled' : ''}>
                                Previous
                            </button>
                            <button data-page="${currentPage + 1}" class="pagination-btn ml-3 relative inline-flex items-center px-4 py-2 text-sm font-medium rounded-md ${currentPage === totalPages ? 'bg-gray-100 text-gray-400 cursor-not-allowed' : 'bg-white text-gray-700 border border-gray-300 hover:bg-gray-50'}" ${currentPage === totalPages ? 'disabled' : ''}>
                                Next
                            </button>
                        </div>
                        
                        <!-- Desktop Pagination -->
                        <div class="hidden sm:flex sm:items-center sm:justify-center sm:flex-1">
                            <nav class="relative z-0 inline-flex rounded-md shadow-sm -space-x-px" aria-label="Pagination">
                                <button data-page="${currentPage - 1}" class="pagination-btn relative inline-flex items-center px-2 py-2 rounded-l-md border border-gray-300 bg-white text-sm font-medium ${currentPage === 1 ? 'text-gray-300 cursor-not-allowed' : 'text-gray-500 hover:bg-gray-50'}" ${currentPage === 1 ? 'disabled' : ''}>
                                    <span class="sr-only">Previous</span>
                                    <i class="fas fa-chevron-left"></i>
                                </button>
                                ${generatePageNumbersWithData(currentPage, totalPages)}
                                <button data-page="${currentPage + 1}" class="pagination-btn relative inline-flex items-center px-2 py-2 rounded-r-md border border-gray-300 bg-white text-sm font-medium ${currentPage === totalPages ? 'text-gray-300 cursor-not-allowed' : 'text-gray-500 hover:bg-gray-50'}" ${currentPage === totalPages ? 'disabled' : ''}>
                                    <span class="sr-only">Next</span>
                                    <i class="fas fa-chevron-right"></i>
                                </button>
                            </nav>
                        </div>
                    </div>
                </div>
            </div>
        `;

        tableDataContainer.innerHTML = html;

        // Attach event listeners to pagination buttons
        document.querySelectorAll('.pagination-btn').forEach(btn => {
            btn.addEventListener('click', function (e) {
                e.preventDefault();
                if (!this.disabled) {
                    const page = parseInt(this.getAttribute('data-page'));
                    console.log('Pagination button clicked, page:', page);
                    changePage(page);
                }
            });
        });
    }

    // Generate data entry form for selected table
    function generateDataForm() {
        const tableName = addDataTableSelector.value;

        if (!tableName) {
            showMessage('Please select a table first', 'error');
            return;
        }

        appState.selectedTable = tableName;
        const table = appState.schema.find(t => t.name === tableName);

        if (!table) {
            showMessage('Table not found', 'error');
            return;
        }

        dataFormContainer.innerHTML = '';
        submitDataContainer.classList.add('hidden');

        const formSection = document.createElement('div');
        formSection.className = 'animate-fadeIn';
        formSection.innerHTML = `
            <div class="flex items-center justify-between mb-6">
                <h3 class="text-lg font-bold text-gray-900">Add New Record to <span class="text-indigo-600">${tableName}</span></h3>
            </div>
            <div id="data-entry-form" class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Form fields will be generated here -->
            </div>
        `;

        const formContainer = formSection.querySelector('#data-entry-form');

        table.columns.forEach(column => {
            // Skip auto-increment ID fields (but NOT for junction tables like books)
            if (tableName !== 'books' && tableName !== 'driver_vehicle') {
                if (column.includes('_id') && (column === 'user_id' || column === 'driver_id' || column === 'vehicle_id' ||
                    column === 'ride_id' || column === 'method_id' || column === 'payment_id' || column === 'rating_id' ||
                    column === 'cash_id')) {
                    return;
                }
            }

            const fieldDiv = document.createElement('div');
            fieldDiv.className = 'form-group';

            let inputType = 'text';
            let placeholder = `Enter ${column}`;
            let required = true;

            // Handle optional fields
            if (column.includes('phone_number') || column.includes('description') ||
                column.includes('comments') || column.includes('type') ||
                column === 'pickup' || column === 'drop_location' || column === 'status' ||
                column === 'expiry' || column === 'name' || column === 'score') {
                required = false;
                placeholder += ' (optional)';
            }

            // Set specific input types
            if (column.includes('date') || column === 'expiry' || column === 'created_at') {
                inputType = 'datetime-local';
            } else if (column.includes('amount') || column.includes('price') || column.includes('unit_price')) {
                inputType = 'number';
                placeholder += ' (numeric)';
            } else if (column.includes('email')) {
                inputType = 'email';
            } else if (column.includes('score') || column === 'method_id') {
                inputType = 'number';
            } else if (column === 'card_no') {
                inputType = 'text';
                placeholder = 'Enter card number (e.g., 4111-1111-1111-1111)';
            } else if (column === 'phone_number') {
                inputType = 'tel';
                placeholder = 'Enter phone number';
            }

            fieldDiv.innerHTML = `
                <label class="form-label">
                    ${column} 
                    ${!required ? '<span class="text-gray-400 font-normal text-xs ml-1">(optional)</span>' : ''}
                </label>
                <input type="${inputType}" 
                       class="form-input focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" 
                       data-column="${column}"
                       placeholder="${placeholder}"
                       ${inputType === 'number' ? 'step="0.01"' : ''}
                       ${required ? 'required' : ''}>
            `;
            formContainer.appendChild(fieldDiv);
        });

        dataFormContainer.appendChild(formSection);
        submitDataContainer.classList.remove('hidden');
    }

    // Submit data to the API
    async function submitData() {
        const tableName = appState.selectedTable;

        if (!tableName) {
            showMessage('No table selected', 'error');
            return;
        }

        const formData = {};
        const inputs = document.querySelectorAll('#data-entry-form input');
        let isValid = true;
        const errors = [];

        inputs.forEach(input => {
            const column = input.getAttribute('data-column');
            const value = input.value.trim();
            const isRequired = input.hasAttribute('required');

            if (isRequired && !value) {
                isValid = false;
                errors.push(`${column} is required`);
                input.classList.add('border-red-500');
            } else {
                input.classList.remove('border-red-500');

                if (value) {
                    if (input.type === 'number') {
                        formData[column] = parseFloat(value);
                        if (isNaN(formData[column])) {
                            isValid = false;
                            errors.push(`${column} must be a valid number`);
                            input.classList.add('border-red-500');
                        }
                    } else if (input.type === 'datetime-local') {
                        formData[column] = new Date(value).toISOString();
                    } else {
                        formData[column] = value;
                    }
                }
            }
        });

        if (!isValid) {
            showMessage(`Please fix the following errors: ${errors.join(', ')}`, 'error');
            return;
        }

        submitDataBtn.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i>Adding...';
        submitDataBtn.disabled = true;

        try {
            console.log('Submitting data to:', `${API_BASE_URL}/tables/${tableName}`);
            console.log('Data:', formData);

            const response = await fetchWithAuth(`${API_BASE_URL}/tables/${tableName}`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify(formData)
            });

            console.log('Response status:', response.status);

            if (!response.ok) {
                const errorText = await response.text();
                throw new Error(`Server responded with ${response.status}: ${errorText}`);
            }

            const result = await response.json();
            console.log('Success:', result);

            inputs.forEach(input => {
                input.value = '';
            });

            showMessage(`Record added successfully to ${tableName} table!`, 'success');

            if (tableSelector.value === tableName) {
                setTimeout(() => {
                    loadTableData();
                }, 1000);
            }

        } catch (error) {
            console.error('Error adding record:', error);
            showMessage(`Failed to add record: ${error.message}`, 'error');
        } finally {
            submitDataBtn.innerHTML = '<i class="fas fa-save mr-2"></i>Add Record';
            submitDataBtn.disabled = false;
        }
    }

